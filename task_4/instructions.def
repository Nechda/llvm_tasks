// enum name, spelling, operand signature (uppercase = destination)
OP(MovI, "mov.i64", "Ii")
OP(MovF, "mov.f32", "Ff")
OP(AddI, "add.i64", "Iii")
OP(SubI, "sub.i64", "Iii")
OP(MulI, "mul.i64", "Iii")
OP(DivI, "udiv.i64", "Iii")
OP(AndI, "and.i64", "Iii")
OP(XorI, "xor.i64", "Iii")
OP(OrI, "or.i64", "Iii")
OP(AddF, "add.f32", "Fff")
OP(SubF, "sub.f32", "Fff")
OP(MulF, "mul.f32", "Fff")
OP(DivF, "div.f32", "Fff")
OP(EqI, "cmp.eq.i64", "Cii")
OP(LtI, "cmp.lt.i64", "Cii")
OP(LtF, "cmp.lt.f32", "Cff")
OP(GtF, "cmp.gt.f32", "Cff")
OP(SelI, "sel.i64", "Icii")
OP(SelF, "sel.f32", "Fcff")
OP(IToF, "itof.f32", "Fi")
OP(FToI, "ftoi.i64", "If")
OP(Load, "ld.f32", "Fm")
OP(Store, "st.f32", "mf")
OP(Fill, "fill.f32", "biif")
OP(Shade, "shade", "Ifff")
OP(Madd, "madd.f32", "Ffff")
OP(Pixel, "pixel", "iii")
OP(Flush, "flush", "")
OP(Jump, "jmp", "l")
OP(Branch, "br", "cll")
OP(Loop, "loop", "Iiil")
OP(Halt, "halt", "")
